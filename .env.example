# Bu dosyayı .env.local olarak kopyalayıp gerçek değerleri gir --
# .env.local git'e gitmez (bkz. .gitignore), Vite onu otomatik okur.
#
# API-Football (api-sports.io DOĞRUDAN plan İSE):
VITE_API_FOOTBALL_HOST=direct
VITE_API_FOOTBALL_KEY=

# API-Football RapidAPI ÜZERİNDEN alındıysa VITE_API_FOOTBALL_HOST=rapidapi yap:
# VITE_API_FOOTBALL_HOST=rapidapi
# VITE_API_FOOTBALL_KEY=

# TheSportsDB (oyuncu/takım görselleri, stadyum) -- ücretsiz "test" anahtarı
# olan "3" ile de çalışır, kendi anahtarınız varsa buraya yazın:
VITE_THESPORTSDB_KEY=3
