rules_version = '2';

// Tahmin Ligi modülü için Firestore güvenlik kuralları.
// UYGULAMA: Bu dosyanın kodu bu repoda tutulur ama BURADAN otomatik olarak
// Firebase projenize DEPLOY EDİLMEZ -- Firebase konsolunda
// (console.firebase.google.com -> projeniz -> Firestore Database -> Rules
// sekmesi) bu dosyanın içeriğini yapıştırıp "Yayınla" demeniz gerekir. (Ya da
// Firebase CLI kuruluysa: `firebase deploy --only firestore:rules`.)
//
// VERİ MODELİ: Tahmin Ligi ÇOKLU, link ile paylaşılan "lig odaları" şeklinde
// çalışır (tek bir global sezon değil) -- bir kullanıcı yeni bir lig
// oluşturur, linkini (leagueId) arkadaşlarıyla paylaşır, onlar da o AYNI
// odaya katılır.
service cloud.firestore {
  match /databases/{database}/documents {

    // leagues/{leagueId}: bir kullanıcının oluşturduğu, link ile paylaşılan
    // Tahmin Ligi odası (kura + fikstür + gerçek sonuçlar). leagueId
    // Firestore tarafından OTOMATİK üretilir (addDoc) -- tahmin edilemez,
    // bu yüzden linki bilmeyen biri bu odaya "rastgele" giremez. Herkes
    // (giriş yapmış herhangi bir kullanıcı, linke sahip olan) okuyabilir.
    // Sadece OLUŞTURAN kişi olarak (createdBy) yaratılabilir --
    // oluşturulduktan sonra İÇERİĞİ client'tan bir daha güncellenemez
    // (fikstür/sonuçlar sabit kalır). SİLİNEBİLİR ("Ligi Sil" özelliği) --
    // "kendi aramızda" güvene dayalı bir özellik, herhangi bir üye
    // silebilir.
    match /leagues/{leagueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      // Sadece bu ligin ÜYESİ (memberships/{leagueId}_{uid} belgesi olan)
      // silebilir -- eskiden herhangi bir GİRİŞ YAPMIŞ kullanıcı (linki hiç
      // açmamış, o lige hiç üye olmamış biri dahi) herhangi bir ligi
      // silebiliyordu, bu "kendi aramızda güvene dayalı" tasarım niyetiyle
      // (bkz. üstteki yorum) uyuşmuyordu -- düzeltildi.
      allow delete: if request.auth != null
                    && exists(/databases/$(database)/documents/memberships/$(leagueId + '_' + request.auth.uid));
      allow update: if false;
    }

    // memberships/{membershipId}: membershipId HER ZAMAN
    // "{leagueId}_{uid}" biçiminde olmalı. Bir kullanıcı bir lig linkini
    // açtığında (ya da yeni bir lig oluşturduğunda) kendi üyeliğini
    // oluşturur -- "Liglerim" listesi bunları okur. Sadece kendi uid'ni
    // taşıyan bir üyelik oluşturabilir/silebilirsin (ligden ayrılmak için).
    match /memberships/{membershipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && membershipId == request.resource.data.leagueId + '_' + request.auth.uid;
      // Kendi üyeliğini ("ligden ayrıl") HER ZAMAN silebilirsin. Başkasının
      // üyeliğini SADECE o ligin bir üyesiysen silebilirsin -- "Ligi Sil"
      // özelliği, ligdeki HERKESİN üyelik kaydını temizlemek için bunu
      // kullanır (bkz. PredictionLeagueContext.deleteLeague). Eskiden bu
      // sadece "kendi uid'in" ile sınırlıydı, yani bir üye ligi silince
      // DİĞER üyelerin üyelik kayıtları silinemiyor, artık silinmiş bir
      // lige işaret eden "yetim" kayıtlar olarak kalıyordu -- düzeltildi.
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || exists(/databases/$(database)/documents/memberships/$(resource.data.leagueId + '_' + request.auth.uid)));
      allow update: if false;
    }

    // predictions/{predictionId}: predictionId HER ZAMAN
    // "{leagueId}_{matchId}_{uid}" biçiminde olmalı -- bu, bir kullanıcının
    // aynı maça birden fazla (çakışan) tahmin belgesi oluşturmasını yapısal
    // olarak imkansız kılar. Bir kullanıcı SADECE kendi uid'siyle
    // etiketlenmiş bir tahmin oluşturabilir, ve mevcut bir tahmin asla
    // GÜNCELLENEMEZ (gerçek sonucu gördükten sonra geriye dönüp "düzeltme"
    // yapılamasın diye) -- bu, dürüst oyuncular için tasarlanmış hafif bir
    // önlemdir (bkz. PredictionLeagueContext.jsx başındaki güvenlik notu).
    // SİLİNEBİLİR: "Tahminlerimi Sıfırla" (kendi tahminini) ve "Ligi Sil"
    // (o ligdeki HERKESİN tahminini) özellikleri bunu kullanır.
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.kind in ['score', 'champion', 'knockout', 'standings', 'teams', 'outcome']
                    && predictionId ==
                       request.resource.data.leagueId + '_' +
                       request.resource.data.matchId + '_' +
                       request.auth.uid;
      // Kendi tahminini ("Tahminlerimi Sıfırla") HER ZAMAN silebilirsin.
      // Başkasının tahminini SADECE o ligin bir üyesiysen silebilirsin --
      // "Ligi Sil" özelliği bunu kullanır (bir üye ligdeki HERKESİN
      // tahminini siler). Eskiden herhangi bir GİRİŞ YAPMIŞ kullanıcı
      // (o lige hiç üye olmamış biri dahi) herhangi bir tahmini
      // silebiliyordu -- düzeltildi.
      allow delete: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || exists(/databases/$(database)/documents/memberships/$(resource.data.leagueId + '_' + request.auth.uid)));
      allow update: if false;
    }
  }
}
